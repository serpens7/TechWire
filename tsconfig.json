{
    "compilerOptions": {
        "outDir": "./dist/",
        "types": ["jest"],
        "noImplicitAny": true,
        "strict": true,
        "module": "ESNext",
        "target": "es6",
        "jsx": "react-jsx",
        "allowJs": true,

        "paths": {
            "@/*": ["./src/*"]
        },
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true
    },
    "ts-node": {
        "compilerOptions": {
            "module": "CommonJS",
            "skipLibCheck": true,
            "types": ["node"]
        }
    },
    "exclude": [
        "node_modules",
        "dist",
        "steiger.config.ts",
        "e2e",
        "playwright.config.ts",
        // Бэкенд — отдельный пакет со своим tsconfig (CommonJS, декораторы,
        // emitDecoratorMetadata). Этим конфигом он не проверяется и не должен:
        // у него свой `npm run type:check` внутри server/.
        "server"
    ]
}
