# Скопируйте в .env и подставьте свои значения.
# .env в git не попадает (см. .gitignore).

# Нативный PostgreSQL 17 (служба postgresql-x64-17).
# Подставьте пароль суперпользователя, заданный при установке Postgres.
DATABASE_URL="postgresql://postgres:ВАШ_ПАРОЛЬ@localhost:5432/techwire?schema=public"

# Секрет для подписи JWT. Для локальной разработки подойдёт любая строка,
# сгенерировать можно так:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="замените-на-случайную-строку"
JWT_EXPIRES_IN="7d"

# Порт бэкенда. Фронт ждёт именно 8000 (см. __API__ в config/build).
PORT=8000

# Искусственная задержка ответа в мс — имитация реальной сети.
# json-server держал 200 мс; лоадеры и тесты фронта к ней привыкли.
RESPONSE_DELAY_MS=200
