  "info": {
    "title": "TechWire API",
    "description": "Бэкенд статейной платформы.\n\nИмена query-параметров (`_limit`, `_page`, `_sort`, `_order`, `q`, `_expand`)\nунаследованы от json-server, который этот сервис заменил: так фронт не\nпотребовал правок, а существующий набор e2e стал приёмочным тестом подмены.\n\nВсе маршруты закрыты, кроме `POST /login` и `GET /health`.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Токен из ответа POST /login"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "db": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "db"
        ]
      },
      "LoginBodyDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "avatar": {
                "type": "string"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "ADMIN",
                    "MANAGER",
                    "USER"
                  ]
                }
              }
            },
            "required": [
              "id",
              "username",
              "roles"
            ]
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "user",
          "token"
        ]
      },
      "RegisterBodyDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 72
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
