            "type": "string"
          },
          "avatar": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ADMIN",
                "MANAGER",
                "USER"
              ]
            }
          }
        },
        "required": [
          "id",
          "username",
          "roles"
        ]
      },
