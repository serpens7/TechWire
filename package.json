{
  "name": "production-project",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node -r ts-node/register ./node_modules/webpack/bin/webpack.js serve --env port=3000",
    "start:dev": "concurrently \"npm start\" \"npm run start:dev:server\"",
    "start:dev:server": "npm --prefix server run start:dev",
    "build:prod": "webpack  --env mode=production",
    "build:dev": "webpack  --env mode=development",
    "type:check": "tsc --noEmit",
    "lint:ts": "eslint \"**/*.{ts,tsx}\"",
    "lint:ts:fix": "eslint \"**/*.{ts,tsx}\" --fix",
    "lint:scss": "npx stylelint \"**/*.scss\"",
    "lint:scss:fix": "npx stylelint \"**/*.scss\" --fix",
    "lint:fsd": "steiger ./src",
    "unit": "jest --config ./config/jest/jest.config.ts",
    "storybook": "storybook dev -p 6006 -c config/storybook",
    "build-storybook": "storybook build -c config/storybook",
    "test": "npm run unit",
    "test:ui:ci": "jest --config ./config/jest/jest.config.ts --ci",
    "e2e": "playwright test",
    "e2e:ui": "cross-env PW_CHANNEL=chrome playwright test --ui",
    "e2e:headed": "cross-env PW_CHANNEL=chrome playwright test --headed",
    "e2e:report": "playwright show-report",
    "server:install": "npm --prefix server ci",
    "api:types": "openapi-typescript server/openapi.json -o src/shared/api/generated/schema.ts",
    "api:sync": "npm --prefix server run openapi && npm run api:types"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.6.0",
    "@playwright/test": "^1.62.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@storybook/addon-actions": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-links": "8.6.14",
    "@storybook/addon-webpack5-compiler-swc": "^1.0.6",
    "@storybook/react": "8.6.14",
    "@storybook/react-webpack5": "8.6.14",
    "@svgr/webpack": "^8.1.0",
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
